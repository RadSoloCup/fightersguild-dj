# ── Required ────────────────────────────────────────────────────────────────
# Bot token for a Fluxer application. Create a SECOND bot (not the sc-tools one)
# in the admin panel, then invite it to the guild with:
#   View Channels, Connect, Speak, Send Messages, Embed Links
FLUXER_BOT_TOKEN=

# ── Server ─────────────────────────────────────────────────────────────────
# Defaults to https://chat.example.com — override for another host.
FLUXER_SERVER_URL=https://chat.example.com
# FLUXER_API_BASE=https://chat.example.com

# ── Commands ───────────────────────────────────────────────────────────────
BOT_PREFIX=!dj
# Restrict commands to specific text channels (comma-separated IDs). Empty = any.
# DJ_COMMAND_CHANNEL_IDS=
# Restrict playback control to specific users. Empty = anyone sharing the bot's
# voice channel can control it.
# DJ_CONTROLLER_USER_IDS=

# ── Audio ──────────────────────────────────────────────────────────────────
DJ_VOLUME=0.5
DJ_IDLE_LEAVE_SECONDS=300
DJ_MAX_TRACK_SECONDS=5400
DJ_MAX_QUEUE=50
# Turn off YouTube/SoundCloud resolution — radio + direct stream URLs only.
# DJ_ENABLE_YTDLP=off
# Extra radio stations: key|Name|https://stream.url  (comma-separated)
# DJ_EXTRA_STATIONS=

# ── LiveKit ────────────────────────────────────────────────────────────────
# Only set this if the bot joins voice but no audio comes through. Point it at a
# LiveKit signalling URL the container can actually reach, e.g. the bridged host
# port from the voice tunnel:
#   LIVEKIT_ENDPOINT_OVERRIDE=ws://127.0.0.1:7880
# LIVEKIT_ENDPOINT_OVERRIDE=
